def get_grade(score):
    if score >= 90:
        return "A+ (Excellent!)"
    elif score >= 80:
        return "A (Very Good)"
    elif score >= 60:
        return "B (Good Job)"
    else:
        return "C (Keep Practicing)" 

my_score = 85
result = get_grade(my_score) 

print(f"Gaurav's Score: {my_score}")
print(f"Final Grade: {result}"))